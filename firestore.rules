rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function vaultDoc(vaultId) {
      return get(/databases/$(database)/documents/vaults/$(vaultId));
    }
    function isVaultOwner(vaultId) {
      return isSignedIn() && vaultDoc(vaultId).data.owner == request.auth.uid;
    }
    function isJoiningSelf() {
      return resource.data.joinedUsers is map &&
        request.resource.data.joinedUsers is map &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedUsers']) &&
        request.resource.data.joinedUsers.diff(resource.data.joinedUsers).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.joinedUsers[request.auth.uid] is string;
    }
    match /users/{userId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /vaults/{vaultId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.owner == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.joinedUsers[request.auth.uid] is string;

      allow update: if isVaultOwner(vaultId) ||
        (isSignedIn() && isJoiningSelf());

      // Only the owner can delete a vault from the client.
      allow delete: if isVaultOwner(vaultId);

      match /dares/{dareId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          (isVaultOwner(vaultId) || vaultDoc(vaultId).data.joinedUsers[request.auth.uid] != null);
        allow update, delete: if isVaultOwner(vaultId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}